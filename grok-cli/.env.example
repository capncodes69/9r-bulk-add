# 9router
ROUTER9_URL=https://your-9router.example
ROUTER9_PASS=your_9router_password

# Default source for split / auto (JSON lines: email + sso_cookies)
# After ./setup.sh paste accounts into sso-pending.txt
SSO_FILE=./sso-pending.txt

# device-code throttle (hindari xAI slow_down)
DEVICE_CODE_GAP=4

# Optional Chrome
# CHROME_BIN=/usr/bin/google-chrome-stable
# CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_BIN=C:\Program Files\Google\Chrome\Application\chrome.exe
