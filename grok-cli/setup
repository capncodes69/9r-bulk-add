#!/usr/bin/env python3
"""First-time setup: .env (if missing) + sso-pending.txt + sso-added.txt.

  python setup
  python setup --os auto|linux|mac|win
"""
from __future__ import annotations

import argparse
import platform
import shutil
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
ENV, ENV_EXAMPLE = ROOT / ".env", ROOT / ".env.example"
PENDING, ADDED = ROOT / "sso-pending.txt", ROOT / "sso-added.txt"
ACCOUNT = ROOT / "account.txt"

PENDING_HEADER = """\
# Paste account JSON lines below (one per line).
# Need at least email + password (for manual export) and sso_cookies (for auto).
# Example:
# {"email":"user@example.com","password":"YourPass123!","sso_cookies":[{"name":"sso","value":"...","domain":".x.ai","path":"/","secure":true,"httpOnly":true,"sameSite":"Lax"}]}
"""


def detect_os() -> str:
    s = platform.system().lower()
    if s == "darwin":
        return "mac"
    if s == "windows":
        return "win"
    return "linux"


def resolve_os(flag: str) -> str:
    flag = (flag or "auto").lower()
    if flag in ("auto", ""):
        return detect_os()
    if flag in ("linux", "mac", "win"):
        return flag
    print(f"unknown --os {flag!r} (use auto|linux|mac|win)", file=sys.stderr)
    sys.exit(2)


def main() -> None:
    ap = argparse.ArgumentParser(description="9r-bulk-add / grok-cli setup")
    ap.add_argument("--os", default="auto", help="auto|linux|mac|win")
    args, _ = ap.parse_known_args()
    os_name = resolve_os(args.os)

    print(f"==> setup (os={os_name})")

    if ENV.exists():
        print("    .env already exists — skip")
    elif ENV_EXAMPLE.exists():
        shutil.copy(ENV_EXAMPLE, ENV)
        print("    created .env from .env.example  (edit ROUTER9_URL / ROUTER9_PASS)")
    else:
        print("    warn: .env.example missing", file=sys.stderr)

    if PENDING.exists():
        print("    sso-pending.txt already exists — skip")
    else:
        PENDING.write_text(PENDING_HEADER, encoding="utf-8")
        print("    created sso-pending.txt  (paste accounts here)")

    if ADDED.exists():
        print("    sso-added.txt already exists — skip")
    else:
        ADDED.write_text("", encoding="utf-8")
        print("    created sso-added.txt  (auto-filled on success)")

    if ACCOUNT.exists():
        print("    account.txt already exists — skip")
    else:
        ACCOUNT.write_text("", encoding="utf-8")
        print("    created account.txt  (python run manual → email:password)")

    print("==> done")
    print("    1) edit .env")
    print("    2) paste accounts into sso-pending.txt")
    print("    3) python run auto          # browser SSO inject")
    print("       python run manual        # export email:password → account.txt")


if __name__ == "__main__":
    main()
