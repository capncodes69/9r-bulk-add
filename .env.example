ROUTER9_URL=https://your-9router.example
ROUTER9_PASS=your_password

# device-code throttle (avoid slow_down)
DEVICE_CODE_GAP=4

# seconds to wait for 9router poll confirmation per account (qoder; grok = 40 fixed)
POLL_TIMEOUT=180

# optional: override Chrome path
# CHROME_BIN=/usr/bin/google-chrome-stable
